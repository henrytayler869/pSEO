DATABASE_URL="postgresql://pseo:pseo@localhost:5433/pseo_control_panel?schema=public"

# DataForSEO API — required for live keyword metric refresh in Module 1.
# Leave both blank to fall back to CSV import for keyword data.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
# How many suggested niches scripts/run-scheduled-niche-research.ts
# processes per run — each niche = one DataForSEO request per real zip.
NICHE_RESEARCH_BATCH_SIZE="3"

# Census Bureau ACS5 API — used by scripts/generate-locations-from-census.ts
# to build a real, population-ranked Location registry (replaces the fake
# 78-city anchor list). Free, instant key at api.census.gov/data/key_signup.html.
CENSUS_API_KEY=""

# NREL PVWatts — Module 2 data collector. Free key at developer.nrel.gov.
NREL_API_KEY=""
# Set to "true" to run the collector with synthetic PVWatts-shaped data when
# no NREL_API_KEY is set (local demo only — never real data, never use for
# anything user-facing).
ALLOW_PVWATTS_MOCK="false"

# Validation gate defaults (Module 3), overridable in AppConfig at runtime.
VALIDATION_BLOCK_RATE_THRESHOLD="0.05"

# Everything else — NOAA/EIA collector tokens, the Cloudflare token +
# account id behind /domains, the /api/v1 key, and the Google Service
# Account JSON that powers /publisher's GSC + GA4 reporting — is entered in
# the app's own Cài đặt (Settings) page and stored in the database, not
# here. A value set in Settings takes precedence over the environment
# anyway, so a deployed server only needs this file for the vars above.
