{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pseo-control-panel-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "atmovingservices",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/user/Documents/atmovingservices && exec npm run dev -- --port 3002"
      ],
      "port": 3002
    }
  ]
}
