# The unit as it ACTUALLY runs on 46.225.145.196 (read from the box
# 2026-09-07). Kept here for provenance, NOT as something to install over what
# is there — the machine was configured before this file existed, and the
# machine is authoritative.
#
# Two things are deliberate and easy to "fix" wrongly:
#
#   No EnvironmentFile=. /opt/pseo/.env is loaded by Next itself from the
#   working directory. Pointing systemd at the same file would parse it a
#   second time under different quoting rules. Scripts run outside Next (tsx)
#   must load dotenv themselves.
#
#   -H 127.0.0.1. The app never binds a public interface; Nginx is the only way
#   in. Dropping the flag would publish it on every interface.
[Unit]
Description=pSEO Control Panel (Next.js)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/pseo
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pseo

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/pseo

[Install]
WantedBy=multi-user.target
