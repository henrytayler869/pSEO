generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PricingModel {
  PER_APPOINTMENT
  PER_CALL_DURATION
  CPL
}

enum ScoreMode {
  PAYOUT // real payoutFloor from a network coverage import
  TRAFFIC // no network yet — scored on SEO opportunity alone
}

enum GeoResolution {
  ZIP
  COUNTY
  METRO
  STATE
}

enum SnapshotStatus {
  OK
  SUSPECT // schema drift or other adapter-level anomaly detected
  FAILED
}

enum FlagSeverity {
  INFO
  WARN
  BLOCK
}

// ---------------------------------------------------------------------------
// Coverage import (raw + parsed)
// ---------------------------------------------------------------------------

// One row per network coverage file import. The raw payload is preserved
// verbatim (never mutated) so every Market row can be traced back to the
// exact file it came from, and two imports can be diffed against each other.
model CoverageImport {
  id         String   @id @default(cuid())
  fileName   String
  network    String // e.g. "NetworkX Home Services"
  importedAt DateTime @default(now())
  rawPayload Json // the parsed CSV/JSON exactly as received, untouched
  rowCount   Int
  notes      String?

  markets Market[]

  @@index([importedAt])
}

// ---------------------------------------------------------------------------
// MarketIdentity — the stable (zip, vertical) concept that survives every
// coverage refresh. Everything that should trend over time (scores, keyword
// data, external DataPoints, eventually Pages) hangs off this, NOT off a
// particular CoverageImport's Market snapshot. Without this, re-importing a
// coverage file produces entirely new Market rows and every history — score
// versioning, page-to-market linkage — silently resets per import instead of
// accumulating per real-world market.
// ---------------------------------------------------------------------------

model MarketIdentity {
  id       String @id @default(cuid())
  zip      String
  vertical String

  // Descriptive label only, frozen at first sighting. City/state for a given
  // zip essentially never change in practice; if a later import disagrees,
  // that's coverage-file noise, not a reason to treat this as versioned data.
  // city is nullable because a MarketIdentity can now originate from the
  // real Census-sourced Location registry (TRAFFIC mode, no coverage file),
  // and Census's ZCTA geography doesn't carry a city name — same reasoning
  // as Location.city.
  city  String?
  state String

  createdAt DateTime @default(now())

  coverageSnapshots Market[]
  keywordMetrics    KeywordMetric[]
  marketScores      MarketScore[]

  @@unique([zip, vertical])
  @@index([vertical])
  @@index([zip])
}

// ---------------------------------------------------------------------------
// Market — one coverage-import-scoped snapshot of a MarketIdentity's
// payout/pricing terms. This is intentionally re-created on every import
// (never updated in place), because payoutFloor/pricingModel/isFlatRate are
// exactly the fields that legitimately change between coverage refreshes and
// must stay traceable to the exact file they came from.
// ---------------------------------------------------------------------------

model Market {
  id String @id @default(cuid())

  marketIdentityId String
  marketIdentity   MarketIdentity @relation(fields: [marketIdentityId], references: [id])

  // Sourced directly from the network's coverage file for this vertical/zip.
  // NOTE: this is a floor, not a guaranteed real payout. Never label it
  // "expected earnings" anywhere in the UI.
  payoutFloor  Float
  pricingModel PricingModel

  // Precomputed at import time by comparing payoutFloor across every zip in
  // the same vertical for the same CoverageImport. If true, ranking by
  // payout is meaningless for this vertical (see MarketScore + UI gating).
  isFlatRate Boolean

  coverageZipCount  Int // total zips in this vertical's coverage footprint at import time
  sourceRefreshedAt DateTime // freshness of the coverage file itself, per the network

  coverageImportId String
  coverageImport   CoverageImport @relation(fields: [coverageImportId], references: [id])

  createdAt DateTime @default(now())

  scoresComputedFromThis MarketScore[] @relation("ScoreSourceMarket")

  @@unique([marketIdentityId, coverageImportId])
  @@index([coverageImportId])
}

// ---------------------------------------------------------------------------
// Keyword metrics (Ahrefs) — tied to the stable identity, not a coverage
// snapshot, since search demand for "hvac repair in Austin" doesn't depend
// on which coverage import happened to (re)discover that zip. Rows are never
// overwritten; a later fetch for the same keyword adds a new row, and
// consumers resolve "current" by taking the most recent fetchedAt per
// keyword — see lib/keywords/latest.ts.
// ---------------------------------------------------------------------------

model KeywordMetric {
  id               String         @id @default(cuid())
  marketIdentityId String
  marketIdentity   MarketIdentity @relation(fields: [marketIdentityId], references: [id])

  keyword           String // the actual keyword pattern queried, e.g. "hvac repair 90210"
  searchVolume      Int
  keywordDifficulty Float // KD, 0-100
  cpc               Float

  /// Ý định tìm kiếm ĐO cho chính từ khoá của thị trường này.
  ///
  /// Per-market chứ không per-niche, vì đo được là nó khác nhau giữa các thị
  /// trường: cùng mẫu "movers {city}" mà "movers chicago" là informational
  /// còn "movers pflugerville" là transactional. Đo 11/9/2026 trên 198 từ
  /// khoá của moving-services: 133 commercial, 41 informational, 13
  /// navigational, 11 transactional.
  ///
  /// Trước đây pipeline gán MỘT ý định cho cả ngành rồi dùng nó cho mọi bài.
  /// Với 174 bài một-địa-điểm, đó là lấy nhãn của đa số áp lên toàn bộ thiểu
  /// số — và thiểu số ở đây là 65 thị trường.
  ///
  /// Null = lần đo đó chưa lấy trường này, KHÔNG phải "không có ý định".
  mainIntent String?

  source    String // "ahrefs_api" | "ahrefs_csv_import"
  fetchedAt DateTime @default(now())

  @@index([marketIdentityId])
  @@index([keyword])
  @@index([mainIntent])
}

// ---------------------------------------------------------------------------
// SemanticKeyword — related/topically-relevant keywords for a vertical as a
// whole (DataForSEO Labs "related_keywords"), not per-zip like KeywordMetric.
// Fetched once per niche (the seed is generic, e.g. "moving services", not a
// city-specific long-tail phrase) — this is real on-page SEO input (what a
// writer should cover/reference), not a scoring input, so it never touches
// MarketScore. Insert-only like KeywordMetric, for the same reason: a later
// fetch just adds a new row, resolved to "latest" via latestPerKeyword().
model SemanticKeyword {
  id       String @id @default(cuid())
  vertical String

  keyword           String
  searchVolume      Int
  keywordDifficulty Float
  cpc               Float

  /// Ý định tìm kiếm DataForSEO đo cho chính truy vấn này:
  /// "informational" | "navigational" | "commercial" | "transactional".
  ///
  /// ĐO, không phải khai báo. Trước đây pipeline tự đặt ra ba "ý định người
  /// đọc" trong code và dựng cả giao diện trên chúng, trong khi endpoint đang
  /// gọi (dataforseo_labs related_keywords) vẫn trả sẵn trường này ở mỗi item
  /// và adapter vứt đi ở bước .map(). Đo 11/9/2026 cho moving-services:
  /// 8 commercial, 1 informational — tức bộ chọn ba nút ngang nhau mô tả sai
  /// hẳn hình dạng thật của ngành.
  ///
  /// Null nghĩa là lần lấy đó chưa có trường này, KHÔNG phải "không có ý
  /// định". Hai chuyện khác nhau, và gộp lại sẽ biến một lần fetch cũ thành
  /// một khẳng định về ngành.
  mainIntent String?

  /// Các ý định phụ cùng xuất hiện cho truy vấn đó. "moving help" là
  /// informational nhưng mang thêm navigational và commercial — một từ khoá
  /// phục vụ nhiều ý định cùng lúc, và ép nó vào một nhãn là bỏ mất điều đó.
  foreignIntent String[]

  source    String // "dataforseo_related_keywords"
  fetchedAt DateTime @default(now())

  @@index([vertical])
  @@index([keyword])
  @@index([vertical, mainIntent])
}

// ---------------------------------------------------------------------------
// CountyKeywordMetric — search demand measured for a COUNTY-sized place,
// sitting between KeywordMetric (per zip) and SemanticKeyword (per whole
// vertical). It exists because keyword resolution and data resolution were
// mismatched: keywords are generated from the Census "Place" name, and all
// 48 NYC zips share the Place "New York" — so every borough inherited
// "movers new york" (18,100 SV, KD 49) even though each borough has its own
// real, far easier term (measured 2026-09-07: brooklyn 6,600/KD 14,
// queens 2,400/KD 2, bronx 1,300/KD 0).
//
// Keyed by countyFips, deliberately NOT by keyword string: a consuming site
// once keyed an exception on a keyword string, this pipeline re-measured and
// changed that string, and the exception broke silently. FIPS codes only
// change when a state reorganises its administrative geography.
//
// Insert-only like KeywordMetric — a re-measurement adds a row and
// consumers resolve "current" by latest fetchedAt.
// ---------------------------------------------------------------------------

model CountyKeywordMetric {
  id         String @id @default(cuid())
  vertical   String
  countyFips String // 5-digit state+county FIPS, joins to Location.countyFips

  // The colloquial place name the keyword was built from (e.g. "brooklyn"
  // for Kings County) — stored so a consumer can see WHY this phrase, and
  // so a wrong mapping is visible in the data rather than buried in config.
  searchPlace String

  keyword           String
  searchVolume      Int
  keywordDifficulty Float
  cpc               Float

  source    String // "dataforseo_api"
  fetchedAt DateTime @default(now())

  @@index([vertical, countyFips])
  @@index([countyFips])
}

// ---------------------------------------------------------------------------
// MarketScore — versioned per MarketIdentity, so score history for a real
// market accumulates continuously across coverage refreshes instead of
// restarting at version 1 every time the network re-sends its file.
// sourceMarketId still pins each score to the exact coverage snapshot whose
// payoutFloor fed the computation, so a specific import's ranked view can
// show "the score computed from this import" rather than whatever the
// latest score happens to be.
// ---------------------------------------------------------------------------

model MarketScore {
  id               String         @id @default(cuid())
  marketIdentityId String
  marketIdentity   MarketIdentity @relation(fields: [marketIdentityId], references: [id])

  // PAYOUT: scored from a real coverage-import Market snapshot (payoutFloor
  // * estConversionRate * searchVolume / difficulty). TRAFFIC: no network
  // relationship exists yet — scored purely on SEO opportunity (searchVolume
  // * cpc / difficulty), no payout data involved. See lib/scoring/.
  mode ScoreMode

  // Which coverage snapshot's payoutFloor/etc this specific computation
  // used. Null for TRAFFIC-mode scores — there is no coverage snapshot.
  sourceMarketId String?
  sourceMarket   Market? @relation("ScoreSourceMarket", fields: [sourceMarketId], references: [id])

  calculatedAt DateTime @default(now())
  version      Int // increments per MarketIdentity — continuous across imports

  score Float

  // Every input to the formula, frozen at calculation time, so a score can
  // always be explained without re-deriving it from possibly-changed data.
  // payoutFloorInput/estConversionRateInput are null in TRAFFIC mode;
  // cpcInput is null in PAYOUT mode (the v1 formula never used CPC).
  payoutFloorInput       Float?
  estConversionRateInput Float?
  cpcInput               Float?
  searchVolumeInput      Int
  difficultyIndexInput   Float
  formulaVersion         String // e.g. "v1: payoutFloor * estConversionRate * searchVolume / difficultyIndex"

  @@unique([marketIdentityId, version])
  @@index([marketIdentityId])
  @@index([sourceMarketId])
  @@index([calculatedAt])
}

// ---------------------------------------------------------------------------
// Data source registry + snapshots
// ---------------------------------------------------------------------------

model DataSource {
  id              String        @id @default(cuid())
  name            String        @unique // "NREL PVWatts", "EIA Electricity Prices", ...
  adapterKey      String        @unique // maps to the adapter implementation, e.g. "nrel_pvwatts"
  endpoint        String
  unit            String // unit of the primary metric this source provides
  geoResolution   GeoResolution
  refreshInterval String // human-readable cadence, e.g. "P30D"
  isActive        Boolean       @default(true)

  // Which niche(s) this source's data is meant to back on a page (e.g.
  // "solar-installation" for PVWatts) — purely descriptive/UI, not read by
  // any adapter or scoring code, so a niche not listed here can still use
  // the data; this is "what it's for," not an access-control list.
  relevantVerticals String[] @default([])

  snapshots DataSnapshot[]

  createdAt DateTime @default(now())
}

model DataSnapshot {
  id         String         @id @default(cuid())
  sourceId   String
  source     DataSource     @relation(fields: [sourceId], references: [id])
  fetchedAt  DateTime       @default(now())
  version    Int // increments per source; snapshots are never overwritten
  status     SnapshotStatus @default(OK)
  statusNote String? // why it's SUSPECT/FAILED, e.g. "response missing expected field 'ac_annual'"

  dataPoints     DataPoint[]
  validationRuns ValidationRun[]

  @@unique([sourceId, version])
  @@index([sourceId])
}

// A place — identified by zip — that external data sources describe.
// Deliberately NOT scoped by vertical: solar irradiance, electricity
// prices, wages, climate all describe a location independent of which
// pay-per-call vertical might eventually have a page there. This also
// carries the zip <-> county <-> metro <-> state crosswalk, since every geo
// inference a DataPoint relies on must be traceable to a row here. A future
// Page (scoped by MarketIdentity, i.e. zip+vertical) joins back to Location
// via zip to pull in whatever DataPoints apply.
model Location {
  id         String  @id @default(cuid())
  zip        String
  city       String? // descriptive only; not every source tells us this
  state      String
  county     String?
  countyFips String?
  metro      String? // CBSA name, nullable — not every zip is in a metro
  cbsaCode   String?

  // ZCTA internal-point centroid (Census Gazetteer file) — required by
  // PVWatts v8 (lib/collector/adapters/pvwatts.ts) since NLR/NREL removed
  // the "address" geocoding param in Feb 2025; nullable because
  // scripts/generate-locations.mjs's old fake demo list never populated
  // this, and the collector adapter fails clearly per-zip if missing
  // rather than guessing.
  lat Float?
  lon Float?

  createdAt DateTime @default(now())

  dataPoints      DataPoint[]
  validationFlags ValidationFlag[]

  @@unique([zip])
  @@index([county])
  @@index([metro])
}

// A single observed value for a place from a given snapshot. Geo-resolution
// mismatches (e.g. a METRO-level BLS figure applied to a ZIP-level Location)
// are recorded explicitly via resolvedAtResolution/isInferred, with
// confidence downgraded accordingly — never silently upsampled.
model DataPoint {
  id         String       @id @default(cuid())
  locationId String
  location   Location     @relation(fields: [locationId], references: [id])
  snapshotId String
  snapshot   DataSnapshot @relation(fields: [snapshotId], references: [id])

  metric String // e.g. "annual_kwh_per_kw", "avg_retail_price_per_kwh"
  value  Float
  unit   String

  // Geo crosswalk trace: the resolution the raw value was actually reported
  // at, vs. the Location's native ZIP. If different, this value was
  // inferred via the crosswalk fields on Location and confidence must
  // reflect that.
  resolvedAtResolution GeoResolution
  isInferred           Boolean       @default(false)
  confidence           Float // 0-1

  createdAt DateTime @default(now())

  @@index([locationId, metric])
  @@index([snapshotId])
}

// ---------------------------------------------------------------------------
// Validation
// ---------------------------------------------------------------------------

model ValidationRun {
  id         String       @id @default(cuid())
  snapshotId String
  snapshot   DataSnapshot @relation(fields: [snapshotId], references: [id])
  runAt      DateTime     @default(now())

  totalLocations   Int
  blockedLocations Int
  warnLocations    Int
  blockRate        Float // blockedLocations / totalLocations

  // Batch gate: if blockRate exceeded the configured threshold, the whole
  // snapshot is barred from proceeding to render, not just the flagged rows.
  batchGatePassed Boolean

  flags ValidationFlag[]

  @@index([snapshotId])
}

model ValidationFlag {
  id              String        @id @default(cuid())
  validationRunId String
  validationRun   ValidationRun @relation(fields: [validationRunId], references: [id])
  locationId      String
  location        Location      @relation(fields: [locationId], references: [id])

  severity FlagSeverity
  rule     String // e.g. "cross_source_deviation", "outlier_vs_regional_mean", "stale_data", "missing_required_metric"
  message  String

  createdAt DateTime @default(now())

  @@index([validationRunId])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// AI interpretation layer — centralised here, NOT in each website.
//
// Each consuming site could call Anthropic itself, but then every site holds
// a copy of the key, and — far worse — every site reimplements the
// anti-fabrication validator. That validator is the only thing standing
// between "a page states a real measured figure" and "a page states a
// number nobody measured", and N implementations of it drift: one site
// already shipped a hardcoded "roughly one resident in five" next to a
// measured 29.5%, in the layer it believed could not invent numbers.
//
// So generation lives where the data lives: one key, one validator, one
// spend ceiling, one cache.
// ---------------------------------------------------------------------------

model AiGeneration {
  id       String @id @default(cuid())
  vertical String

  zip String

  // Fingerprint of the exact facts the text was generated from. Cache hits
  // require an identical fingerprint, so re-collecting data (new snapshot,
  // re-measured keyword) can never serve text written about the old
  // numbers — the stalest possible failure, since the text would still read
  // as confidently true.
  factsFingerprint String

  prompt String // stored verbatim: without it, a suspect output can't be diagnosed
  text   String

  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float

  // Write-time verdict. Text that fails validation is still stored (with
  // the reason) rather than dropped — a rejected generation is evidence
  // about the prompt, and silently discarding it hides a systematic problem.
  validationPassed Boolean
  validationNotes  String?

  createdAt DateTime @default(now())

  @@index([vertical, zip])
  @@index([factsFingerprint])
}

/// Đoạn diễn giải cho một CỤM, không phải cho một ZIP.
///
/// Bảng riêng chứ không thêm cột nullable vào AiGeneration: mỗi hàng ở bảng
/// kia nói về đúng một ZIP, và nới `zip` thành nullable buộc mọi truy vấn đã
/// viết phải cân nhắc một trạng thái chúng chưa từng gặp. Hai thứ khác nhau
/// về hình dạng fact (dải vs giá trị đơn) và khác cả bộ luật kiểm.
model AiClusterGeneration {
  id       String @id @default(cuid())
  vertical String

  /// Hash của tập ZIP thành viên đã sắp xếp.
  ///
  /// KHÔNG dùng đường dẫn trang hay khoá từ khoá làm danh tính: guide §3.5 ghi
  /// rõ mainKeyword đổi được, và một đợt sửa mẫu đã đổi chuỗi của 233/582
  /// market. Tập ZIP đổi khi và chỉ khi cụm thật sự đổi — mà lúc đó dải cũng
  /// đổi và văn bản cần viết lại.
  clusterId  String
  /// Đường dẫn trang cụm lúc sinh. Chỉ để tra cứu, không phải khoá.
  label      String
  memberZips String[]

  factsFingerprint String

  prompt String
  text   String

  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float

  validationPassed Boolean
  validationNotes  String?

  createdAt DateTime @default(now())

  @@index([vertical, clusterId])
  @@index([factsFingerprint])
}

/// Một URL đã gửi tới dịch vụ index bên thứ ba — hoặc CỐ TÌNH không gửi.
///
/// Hàng `arm: "control"` là phần quan trọng nhất của bảng này. Dịch vụ hứa
/// "indexed in 24 hours or refunded", nhưng một trang mới cuối cùng cũng được
/// index dù có gửi hay không — nên "đã gửi rồi thấy index" KHÔNG chứng minh
/// gì. Chỉ có chênh lệch giữa nhóm gửi và nhóm giữ lại mới chứng minh được,
/// và nhóm giữ lại phải chọn TRƯỚC khi gửi, không phải chọn sau khi nhìn kết
/// quả.
///
/// API của họ trả về đúng chuỗi "done" — không campaign id, không trạng thái
/// từng URL. Nên bảng này ghi lại phía mình đã gửi gì; câu trả lời "đã index
/// chưa" lấy từ URL Inspection của Google, không lấy từ họ.
model IndexSubmission {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  url String

  /// "submitted" = đã gửi cho dịch vụ. "control" = cố tình KHÔNG gửi.
  /// "manual" = bấm tay trong Search Console; đã nhận can thiệp nên KHÔNG
  /// được xuất hiện ở hai nhánh kia.
  arm String

  /// Tên dịch vụ. Nhiều dịch vụ cùng loại tồn tại, và trộn chúng vào một
  /// phép đo sẽ cho ra một con số không nói về dịch vụ nào.
  provider String

  campaignName String?
  dripfeedDays Int?

  /// Trạng thái index ĐO ĐƯỢC lúc gửi, để so với lần đo sau. Null = chưa đo.
  indexedAtSubmit Boolean?

  submittedAt DateTime @default(now())

  checks IndexCheck[]

  @@unique([websiteId, url, provider])
  @@index([websiteId, arm])
}

model AiSpend {
  id String @id @default(cuid())

  vertical String

  /**
   * Nullable since 2026-09-11: an editorial article spans many ZIPs, so there
   * is no single one to charge it to.
   * The row is still written, and that is the point — `getTotalSpendUsd()`
   * sums this table with no filter, so anything that skipped it would spend
   * outside the hard cap. A second ledger for articles would have been the
   * easy shape and would have made the cap silently stop covering the newest
   * way to spend money.
   */
  zip String?

  /// Set for article generation, so per-publisher cost is a query rather than
  /// an estimate. Null for market interpretation, which is not per-site.
  websiteId String?
  articleId String?

  model String

  inputTokens  Int
  outputTokens Int
  costUsd      Float

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Domain — real domains acquired for a pSEO site, registered here BEFORE a
// Website (below) can exist: a Website needs a live WordPress install plus
// verified GSC/GA4 properties, none of which can exist until the domain is
// owned and its DNS is under control. Adding a Domain here creates a real
// zone in Cloudflare via the Cloudflare API (lib/cloudflare/zones.ts) — this
// is the "add the domain into the system" step, not a placeholder record.
// ---------------------------------------------------------------------------

model Domain {
  id   String @id @default(cuid())
  name String @unique // e.g. "atmovingservices.com" — the real, purchased domain

  // Purely descriptive — which niche this domain is meant to serve, same
  // "annotation, not access control" role as DataSource.relevantVerticals.
  relevantVertical String?

  cloudflareZoneId String? // null if the Cloudflare call never succeeded
  cloudflareStatus String? // mirrors Cloudflare's own zone.status verbatim: initializing/pending/active/moved
  nameServers      String[] @default([]) // Cloudflare-assigned nameservers to set at the registrar
  cloudflareError  String? // last error message if adding to Cloudflare failed — never silently blank

  lastCheckedAt DateTime? // last time status/nameservers were refreshed from Cloudflare
  createdAt     DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Publisher — external programmatic websites this control panel coordinates
// as their "Head Quarter": headless WordPress (CMS) + Next.js (frontend)
// sites built in separate sessions/projects, connected here for read-only
// GSC + GA4 reporting. Deliberately just connection metadata — post lists,
// traffic breakdowns, and index status are always fetched live from
// WordPress/GSC/GA4 at view time (lib/queries/publisher.ts), not mirrored
// into this DB, so numbers can never go stale relative to the real source.
// ---------------------------------------------------------------------------

/// One item on the QC checklist, stored as DATA so Settings can edit it.
///
/// GLOBAL, not per publisher: the checklist is what Control Panel REQUIRES of
/// every pub site. A per-site checklist would let a site opt out of the rule
/// it keeps failing, which is the one case the rule exists for.
///
/// An honest boundary, stated because the UI must not pretend otherwise:
///
///   BUILT-IN rules are code. Settings can turn them off and change their
///   thresholds; it cannot change what they inspect. `facts-verified` runs the
///   validator, and no amount of JSON edits makes it inspect something else.
///
///   CUSTOM rules are patterns — a regex that must appear, or must not. That
///   is genuinely addable without a deploy, and it is the honest extent of
///   "add a rule" in a text field.
///
/// A button offering to add arbitrary new logic as data would be a lie, and
/// the lie would only surface the day someone relied on a rule that never ran.
model QcRule {
  id String @id @default(cuid())

  /// "content" or "technical" — which checklist it belongs to.
  kind    String
  /// Matches a coded check id for built-ins; free text for custom rules.
  checkId String @unique
  label   String
  why     String

  builtin  Boolean @default(false)
  isActive Boolean @default(true)

  /// Built-in: thresholds, e.g. { "min": 30, "max": 65 }.
  /// Custom: { "mode": "must-not-match" | "must-contain", "pattern": "...", "flags": "i" }.
  params Json

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

/// A publisher's own article template, stored as DATA rather than code.
///
/// Per publisher, not shared: two sites in the same trade should not publish
/// the same skeleton, and a template living in HQ's source means changing one
/// site's layout is a deploy that changes every site's layout.
///
/// Blocks are ordered and typed. The AI paragraph is ONE block among them —
/// that ratio is the point. The market pages this mirrors measure 90% template
/// to 10% model (1,061 of 10,674 characters), and that split is what makes the
/// numeric contract enforceable: almost nothing in the page came from a model,
/// so almost nothing in it can be invented.
model ArticleTemplate {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  /// Which reader intent this template serves. One template per intent per
  /// site: the same data serves three different readers and they do not want
  /// the same page.
  intent String
  name   String

  /// Ordered blocks. See lib/article-template/render.ts for the shapes.
  blocks Json

  /// Deactivated rather than deleted — a template that produced published
  /// articles is the only record of how they were built.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([websiteId, intent, name])
  @@index([websiteId, isActive])
}

/// One editorial article, from candidate to WordPress draft.
model Article {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  /// Candidate it came from — stable across runs, so the same angle is not
  /// offered again once written.
  candidateId String
  vertical    String
  intent      String
  angle       String

  title   String
  content String

  /**
   * Every attempt, not just the last.
   * A rewrite loop that only kept the winning draft would hide the thing most
   * worth seeing: which check failed, how often, and whether the model fixed
   * it or merely moved the problem. Cost is charged per attempt, so attempts
   * is also what makes the price of an article explainable.
   */
  attempts Int   @default(1)
  costUsd  Float @default(0)

  /// Result of the last QC run: which checks passed, which failed and why.
  qcReport Json

  /// "draft" until every check passes; "failed" when the loop gave up.
  status String @default("draft")

  /// WordPress post id once created. Null means QC passed but nothing was
  /// written yet — a distinct state from "not generated".
  wpPostId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([websiteId, candidateId])
  @@index([websiteId, status])
}

/// A batch run, so a long generation can be watched and resumed.
model ArticleJob {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  intent String

  total  Int @default(0)
  done   Int @default(0)
  failed Int @default(0)

  /// "running" | "done" | "stopped". A job left "running" with no progress is
  /// a job whose process died — visible as a stuck bar rather than as silence.
  status String @default("running")

  /// Last thing it was working on, so a stuck job says WHERE it stuck.
  currentTitle String?
  error        String?

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([websiteId, status])
}

model Website {
  id   String @id @default(cuid())
  name String

  // Public site origin, e.g. "https://example.com" — used to derive the
  // WordPress REST API base (`${url}/wp-json/wp/v2`) unless wpApiBaseUrl
  // overrides it (some sites proxy /wp-json elsewhere, e.g. a headless CMS
  // subdomain).
  url          String
  wpApiBaseUrl String?

  // Which trade this site publishes. NOT NULL on purpose.
  //
  // Added 2026-09-10 because its absence was a hard blocker, not an
  // inconvenience: every content rule that depends on trade vocabulary
  // (`patternsFor()` in lib/content-rules/copy-patterns.ts) REFUSES to run for
  // a trade it has no vocabulary for — which is correct — and with no vertical
  // on the site row there was no way for an automated check to learn which
  // trade a publisher belongs to. One site can be told by hand; the second
  // one is where that stops working.
  //
  // A nullable column would have moved the problem rather than solved it: the
  // checker still could not run, and now the reason would be a null instead of
  // a missing field.
  //
  // No foreign key, matching MarketIdentity.vertical: the set of trades lives
  // in the coverage data, not in a table, and inventing a Vertical table here
  // would create a second definition of what a trade is. Validated on write
  // against the trades that actually have markets — see app/publisher/actions.ts.
  vertical String

  /**
   * WordPress Application Password, for WRITING posts from this panel.
   * Two fields because WP Basic auth needs both, and the username is not
   * derivable — an Application Password is issued TO a user account.
   * NOT the account password. WordPress issues application passwords per
   * application; they can be revoked one at a time without changing the login,
   * and they are what WP itself documents for REST writes. Head Quarter never
   * holds the account password.
   * Nullable, and reading still works without it: WP serves published content
   * unauthenticated. So a site with no credential shows a read-only list
   * rather than an error — but it cannot see drafts, and the UI says so
   * instead of showing a shorter list that looks complete.
   * Stored in the clear, same as `revalidateSecret` above. That is the
   * existing shape of this table and not a decision made here; the panel sits
   * behind Basic Auth on nginx and the database is not reachable from the
   * internet. Worth revisiting together with revalidateSecret if either ever
   * needs to be, not one at a time.
   */
  wpUsername    String?
  wpAppPassword String?

  /**
   * Shared secret proving a WordPress request came from Head Quarter itself.
   * Sent as X-Atms-Loopback on every write. The publisher's must-use plugin
   * compares it and only then re-enables Application Passwords, which
   * WordPress disables on non-SSL connections.
   * Why a secret rather than a network property. Three network-based scopes
   * were tried and each rested on an assumption about the infrastructure:
   * REMOTE_ADDR === 127.0.0.1   never matches — the published port means the
   * container sees the bridge gateway
   * absence of X-Forwarded-For  measured false 2026-09-10: mod_remoteip
   * CONSUMES the header, so PHP never sees it and
   * the filter matched every non-SSL request
   * REMOTE_ADDR in RFC1918      still rests on mod_remoteip, the very thing
   * we had just proven we misunderstood
   * A string comparison rests on nothing. Docker can renumber its subnet, the
   * published port can change, a proxy can be added — none of it moves this.
   * The threat model is unchanged: whatever can read this secret can already
   * read /opt/pseo/.env on the same host. It is not an escalation path. What it
   * buys is that everyone ELSE — including a public HTTP route someone adds
   * later — is excluded without anyone having to remember why.
   * Null means the publisher has no such plugin, and writes then fail with 401
   * rather than succeeding through a wider door.
   */
  wpLoopbackSecret String?

  /**
   * Câu một dòng dưới tên site, và đoạn mô tả dùng cho thẻ meta description.
   * Nằm ở đây thay vì trong mã nguồn site vì mô hình đã đổi: MỘT app phục vụ
   * nhiều domain, phân biệt theo Host. Hằng số trong `lib/site.ts` chỉ đúng
   * khi mỗi site là một bản build riêng — với app dùng chung, nó sẽ gán danh
   * tính của site này cho mọi site khác.
   * NULLABLE trong database, nhưng KHÔNG phải tuỳ chọn về mặt sản phẩm: thiếu
   * description là ship một thẻ meta rỗng, và đó là hỏng SEO không ai thấy
   * trên màn hình. Cột để null được là để migration không vỡ hàng đang có;
   * chỗ chặn nằm ở `ready`/`missing` của /api/v1/sites/{host}/config, nơi một
   * site chưa đủ danh tính bị từ chối DỰNG chứ không phải bị dựng ra rỗng.
   * Hai trường riêng chứ không gộp: tagline hiện trên trang, description hiện
   * trong kết quả tìm kiếm. Dùng chung một chuỗi cho hai chỗ là để một trong
   * hai luôn sai độ dài.
   */
  tagline     String?
  description String?

  /**
   * What this site is currently optimising for. Drives which recommendations
   * Control Panel makes from the same metrics — a site chasing index coverage
   * and a site chasing leads read the same numbers and should be told
   * different things.
   * Null means nobody has chosen, and the panel says so rather than assuming
   * traffic. An assumed goal produces confident advice for a target the owner
   * never set.
   */
  goal String?

  articles         Article[]
  articleJobs      ArticleJob[]
  templates        ArticleTemplate[]
  indexSubmissions IndexSubmission[]
  apiKeys          PublisherApiKey[]

  // Search Console property identity, e.g. "sc-domain:example.com" or
  // "https://example.com/" (URL-prefix form) — GSC requires the exact
  // registered format, see README once written.
  gscPropertyUrl String

  // GA4 numeric property ID (the "G-XXXXXXX" measurement ID is different
  // from this — GA4 Data API calls use "properties/{propertyId}", the
  // numeric Analytics property ID, not the measurement ID).
  ga4PropertyId String

  // The OTHER GA4 identifier: the "G-XXXXXXXXXX" measurement ID that the
  // site itself sends events with. Stored here so it is managed in one place
  // rather than hand-edited into a file on the server.
  //
  // The two are not interchangeable and neither one can be derived from the
  // other. ga4PropertyId READS reports; this one WRITES events. Swapping them
  // fails in the quietest possible way — the Data API rejects a "G-" string,
  // and a numeric ID in a gtag call collects nothing while every page still
  // renders — so both are validated on entry.
  //
  // Optional: a site can be connected for GSC and WordPress reporting before
  // anyone has set up analytics, and refusing the connection until then would
  // be inventing a dependency that does not exist.
  ga4MeasurementId String?

  // Shared secret for POSTing to the site's own /api/revalidate, so a setting
  // changed here takes effect immediately instead of waiting out a cache.
  // Optional — without it the site still updates, just on the slow path.
  revalidateSecret String?

  // The DataForSEO OnPage crawl this website last started. Kept so its results
  // can be re-read for free; starting a new crawl is what costs money.
  onPageTaskId   String?
  onPageTaskAt   DateTime?
  onPageMaxPages Int?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  /// Ngân sách AI của publisher này, USD. Null = chưa đặt.
  ///
  /// MỀM, không chặn. Nội dung của publisher phụ thuộc hoàn toàn vào AI,
  /// nên một trần chặn cứng ở đây chỉ dừng sản phẩm chứ không tiết kiệm
  /// được gì — thứ cần là biết mình đang ở đâu so với dự tính. Chặn cứng
  /// chống chạy loạn vẫn còn, ở AppConfig key "ai", và là con số khác hẳn.
  ///
  /// Null phải hiện ra là "chưa đặt", không được hiện ra là "đang trong
  /// ngân sách": một ô xanh cho một ngân sách không tồn tại là câu trả lời
  /// sai cho câu hỏi người ta thực sự hỏi.
  aiBudgetUsd      Float?
  indexRecheckRuns IndexRecheckRun[]
  scheduledChecks  ScheduledCheck[]

  @@unique([gscPropertyUrl])
  // Khai ở đây vì migration 20260912000000 đã TẠO index này trên
  // database. Thiếu dòng này thì schema và migrations lệch nhau vĩnh viễn,
  // và `prisma migrate diff` — phép kiểm duy nhất bắt được cột khai nhầm
  // model — sẽ đỏ sẵn, tức là một cổng người ta sẽ tắt.
  @@index([vertical])
}

/// Một lần ĐO trạng thái index của một URL.
///
/// Bảng riêng chứ không phải hai cột trên IndexSubmission, vì câu hỏi thật
/// là "nó đi theo hướng nào", không phải "bây giờ thế nào". Hai cột
/// lastCheckedAt/indexedNow trả lời được câu thứ hai và xoá mất câu thứ
/// nhất: mỗi lần đo ghi đè lần trước, nên không ai thấy được một URL từng
/// vào chỉ mục rồi rơi ra.
model IndexCheck {
  id           String          @id @default(cuid())
  submissionId String
  submission   IndexSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// verdict của GSC: PASS, NEUTRAL, FAIL, ERROR.
  verdict String

  /// coverageState nguyên văn. Giữ chuỗi thô chứ không quy về boolean:
  /// "Crawled - currently not indexed" và "Discovered - currently not
  /// indexed" đều là "chưa index" nhưng dẫn tới hai hành động khác nhau.
  coverageState String

  /// lastCrawlTime của Google, nếu có. Null = Google chưa từng crawl.
  lastCrawlAt DateTime?

  checkedAt DateTime @default(now())

  @@index([submissionId, checkedAt])
}

/// Khoá API của MỘT publisher, thay cho một khoá dùng chung cho tất cả.
///
/// Vì sao đổi: khoá dùng chung cũ nằm NGUYÊN VĂN trong AppConfig, đọc được
/// mọi niche, và không thu hồi riêng cho ai được — thu hồi nó là làm chết
/// mọi site cùng lúc. Với một publisher thì đó là bất tiện; với publisher
/// thứ hai thì đó là lý do không ai dám thu hồi, tức là một khoá không thu
/// hồi được.
///
/// Nhiều hàng còn sống cho cùng một website là CỐ Ý: xoay khoá phải là tạo
/// khoá mới → đổi bên publisher → thu hồi khoá cũ. Ép mỗi site một khoá thì
/// mọi lần xoay đều có một quãng site chết.
/// MỘT lần chạy của pipeline đo lại index — kể cả lần BỎ QUA và lần HỎNG.
///
/// Vì sao ghi cả lần bỏ qua: không có nó thì "pipeline chạy đều, hôm nay chưa
/// tới hạn" và "pipeline chết ba tuần rồi" trông giống hệt nhau trên màn hình
/// — cùng là một ngày tháng cũ. Đó đúng là kiểu hỏng mà routine bấm tay mắc
/// phải và là lý do pipeline này tồn tại; chép lại nó dưới dạng tự động thì
/// không được gì.
///
/// Nên hàng BỎ QUA là nhịp tim, hàng có `checked` là phép đo, và màn hình đọc
/// hai thứ đó bằng hai câu khác nhau.
model IndexRecheckRun {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  /// "scheduled" = timer gọi. "manual" = người bấm nút.
  trigger String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  checked Int @default(0)
  failed  Int @default(0)

  /// Lý do KHÔNG đo lần này. Null = có đo thật.
  skipped String?

  /// Lỗi làm cả lần chạy gãy — khác `failed`, vốn đếm từng URL hỏi không được.
  error String?

  @@index([websiteId, startedAt])
}

/// Kết quả MỘT lần chạy của một phép kiểm định kỳ, kể cả khi sạch.
///
/// Ghi cả lần sạch vì câu "kiểm lần cuối lúc nào" chỉ trả lời được như thế —
/// và một bảng chỉ chứa lần hỏng thì im lặng có hai nghĩa: mọi thứ ổn, hoặc
/// phép kiểm đã ngừng chạy. Đó đúng là sự nhập nhằng mà IndexRecheckRun dựng
/// ra để chặn, ở một chỗ khác.
model ScheduledCheck {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  /// Loại kiểm. "gtag-host-leak" = có phiên GA4 nào từ host không phải site.
  kind String

  ok     Boolean
  /// Câu người đọc được. Với lần hỏng, nó phải NÊU TÊN thứ hỏng chứ không chỉ
  /// đếm — một con số không kèm host thì không ai đi tìm được gì.
  detail String

  checkedAt DateTime @default(now())

  @@index([websiteId, kind, checkedAt])
}

model PublisherApiKey {
  id String @id @default(cuid())

  /// Null = khoá KHÔNG giới hạn niche. Chỉ đúng một hàng như vậy tồn tại:
  /// khoá dùng chung cũ, được chuyển vào bảng này để đường xác thực chỉ có
  /// MỘT nhánh thay vì một nhánh mới và một nhánh dự phòng.
  ///
  /// Ràng buộc "chỉ một" cố tình KHÔNG đặt bằng partial unique index: Prisma
  /// không biểu diễn được index đó, nên nó sẽ hiện ra là lệch schema và làm
  /// đỏ sẵn `prisma migrate diff` — cổng duy nhất bắt được cột khai nhầm.
  /// Một cổng đỏ sẵn là một cổng người ta sẽ tắt. Ràng buộc nằm ở
  /// scripts/backfill-legacy-api-key.ts, và nó chỉ chạy một lần.
  websiteId String?
  website   Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  /// Phần đầu khoá, nguyên văn. KHÔNG bí mật — đây là thứ hiện trên màn hình
  /// để biết "khoá nào", và là thứ tra cứu, vì khoá đầy đủ chỉ lưu dạng băm.
  keyPrefix String @unique

  /// SHA-256 của khoá đầy đủ. Khoá đầy đủ KHÔNG tồn tại ở đâu trong hệ thống
  /// này sau khi màn hình sinh khoá đóng lại. Đó là điểm của thay đổi.
  keyHash String @unique

  /// Ai/cái gì cầm khoá này, do người đặt. Để khi cần thu hồi thì biết thu
  /// hồi cái nào mà không phải đoán.
  label String

  /// Lần cuối khoá này xác thực thành công. Ghi có tiết chế (xem
  /// lib/api/auth.ts) vì nó nằm trên đường đi của mọi request.
  ///
  /// Đây là thứ duy nhất trả lời được "thu hồi khoá này có làm chết gì
  /// không". Thiếu nó thì việc thu hồi khoá cũ vĩnh viễn là một canh bạc, và
  /// người ta sẽ chọn không thu hồi.
  lastUsedAt DateTime?

  /// Đánh dấu thay vì xoá hàng: một khoá đã thu hồi vẫn cần đọc được để trả
  /// lời "khoá bị lộ hôm đó đã dùng lần cuối lúc nào".
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([websiteId])
}

// ---------------------------------------------------------------------------
// TRỤC TRANG THỨ HAI — cho site KHÔNG có địa lý
//
// Vì sao là bảng riêng chứ không nới `Location`/`MarketIdentity`.
//
// Trục hiện tại xoay quanh mã ZIP của Mỹ và xoay thật, không phải trên danh
// nghĩa: `Location` unique theo `zip`, `MarketIdentity` unique theo
// `(zip, vertical)`, `state` không nullable, không có cột quốc gia. Đo
// 22/9/2026: 623 dòng mã KHÔNG phải chú thích ở HQ và 310 dòng bên publisher
// nhắc tới `zip`. Tổng quát hoá tại chỗ nghĩa là đọc lại từng đó dòng trên
// một database đang phục vụ HAI site sống — và nghĩa là phải chọn ĐÚNG hình
// dạng khoá chung ngay lần đầu, vì lần thứ hai là một migration nữa trên
// cùng database đó.
//
// Bảng này đảo thứ tự: hình dạng khoá chung được chứng minh trên bóng đá
// trước, nơi chưa site nào sống nên làm hỏng không tốn gì. Nếu nó đứng vững,
// trục địa lý chuyển về đây sau với `axis = "zip"` và `Location` thành thứ
// treo bên cạnh chứ không phải danh tính. Nếu nó không đứng vững, thứ phải
// vứt đi là hai bảng chưa ai dùng.
//
// GIÁ PHẢI TRẢ, nêu ra vì nó có thật: từ đây có HAI định nghĩa "một trang là
// gì" cùng sống trong một schema. Kho này đã trả giá cho bản sao trôi lệch
// nhiều lần (launch.json, NICHES_WITH_COPY, PILLARS_BY_VERTICAL). Chỗ khác
// biệt là hai định nghĩa này KHÔNG mô tả cùng một tập trang — không hàng nào
// ở đây được phép mang `axis = "zip"` chừng nào `MarketIdentity` còn sống, và
// đó là bất biến `scripts/verify-page-axis.ts` canh.
// ---------------------------------------------------------------------------

/// Danh tính một trang của site KHÔNG có địa lý.
///
/// ═══ `axis` LÀ CHUỖI, KHÔNG PHẢI ENUM ═══
///
/// Cùng lý lẽ với `MarketIdentity.vertical` và `Website.vertical`: một enum ở
/// đây buộc mọi niche không-địa-lý về sau phải đi kèm một migration chỉ để
/// khai một từ. Khác với `vertical` ở chỗ tập giá trị của `axis` sống trong
/// mã chứ không trong dữ liệu — nên nó được canh ở `lib/page-axis/axes.ts`
/// thay vì ở database, và `scripts/verify-page-axis.ts` đỏ khi database có
/// một `axis` không ai khai.
///
/// ═══ `key` KHÔNG CHỨA MÙA, VÀ ĐÓ LÀ QUYẾT ĐỊNH VỀ SEO ═══
///
/// `"en-1/arsenal-fc"` chứ không phải `"2026-27/en-1/arsenal-fc"`. Trang đội
/// là trang ĐỌC ĐƯỢC QUANH NĂM (brief mục 4.2): nó luôn hiện mùa đang đá, và
/// URL của nó không đổi khi sang mùa mới. Nhét mùa vào khoá sẽ sinh một bộ
/// URL mới mỗi tháng Bảy và vứt bỏ toàn bộ thẩm quyền đã tích được — đúng thứ
/// duy nhất mà một site mới không mua được.
///
/// Mùa là NỘI DUNG, không phải danh tính. Trang lưu trữ theo mùa (15 mùa C1)
/// là chuyện khác và sẽ có `axis` riêng khi tới lượt nó.
model EntityIdentity {
  id       String @id @default(cuid())
  vertical String

  /// "league" | "team" | "fixture". Xem `lib/page-axis/axes.ts`.
  axis String

  /// Khoá ổn định, do nguồn quyết chứ không do tên hiển thị quyết.
  ///
  /// Tên đội đổi được ("Manchester United FC" -> "Manchester United"), và
  /// openfootball đã đổi định dạng .txt giữa hai mùa liền nhau. Khoá dựng từ
  /// mã giải của nguồn cộng slug đã chuẩn hoá, nên một lần đổi tên hiển thị
  /// KHÔNG tạo ra một trang mới — nó sửa `displayName` tại chỗ.
  key String

  /// Khoá của trang cha, để dựng breadcrumb và liên kết nội bộ mà không phải
  /// phân tích chuỗi `key`. Null cho trang gốc của trục (giải).
  ///
  /// Không đặt FK tự trỏ: hàng cha và hàng con được ghi trong cùng một đợt
  /// đồng bộ, và một FK sẽ bắt đợt đó phải có thứ tự. Ràng buộc thật là
  /// "parentKey trỏ tới một key có tồn tại trong cùng vertical", và đó là
  /// thứ `verify-page-axis.ts` kiểm sau khi đợt ghi xong.
  parentKey String?

  /// Chuỗi người đọc thấy. Mô tả, KHÔNG phải danh tính — xem `key`.
  displayName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generations AiEntityGeneration[]

  @@unique([vertical, axis, key])
  @@index([vertical, axis])
  @@index([vertical, parentKey])
}

/// Đoạn diễn giải AI cho một trang trên trục không-địa-lý.
///
/// Bảng riêng chứ không nới `AiGeneration.zip` thành nullable, và lý lẽ là
/// lý lẽ đã viết sẵn ở `AiClusterGeneration`: mỗi hàng bên đó nói về đúng một
/// ZIP, và cho `zip` null buộc MỌI truy vấn đã viết phải cân nhắc một trạng
/// thái chúng chưa từng gặp. Nhét `"en-1/arsenal-fc"` vào cột tên `zip` thì
/// còn tệ hơn — số đúng nhãn sai là loại lỗi đi qua được mọi validator, vì
/// validator so văn bản với fact chứ không so tên cột với thực tế.
///
/// Có FK thật, khác `AiGeneration` (giữ `vertical` + `zip` rời). Không phải
/// vì bên kia sai — bên kia có trước `MarketIdentity` — mà vì ở đây danh tính
/// ĐÃ là một hàng, nên không có cớ gì để tham chiếu nó bằng hai chuỗi.
model AiEntityGeneration {
  id String @id @default(cuid())

  entityIdentityId String
  entityIdentity   EntityIdentity @relation(fields: [entityIdentityId], references: [id], onDelete: Cascade)

  /// Vân tay của ĐÚNG tập fact đã sinh ra văn bản này.
  ///
  /// Cùng vai trò với `AiGeneration.factsFingerprint` và quan trọng hơn ở
  /// đây: fact bóng đá đổi sau MỖI VÒNG ĐẤU, không phải sau mỗi đợt thu thập
  /// dữ liệu vài tháng một lần. Một đoạn văn viết cho Arsenal sau 5 trận vẫn
  /// đọc trôi chảy sau 6 trận, và vẫn sai. Cache chỉ trúng khi vân tay khớp.
  factsFingerprint String

  prompt String
  text   String

  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float

  validationPassed Boolean
  validationNotes  String?

  createdAt DateTime @default(now())

  @@index([entityIdentityId])
  @@index([factsFingerprint])
}
